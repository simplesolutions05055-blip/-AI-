{
  "name": "primeos",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-ui.mjs && vite",
    "build": "node scripts/sync-design.mjs && node scripts/build-ui.mjs && node video/scripts/bundle.mjs && vite build",
    "preview": "vite preview",
    "typecheck:api": "tsc -p tsconfig.api.json --noEmit",
    "typecheck": "node --check public/primeos-live.js && node --check scripts/build-ui.mjs",
    "check:functions": "deno check --config supabase/functions/deno.ci.json --node-modules-dir=auto supabase/functions/v2-api/index.ts supabase/functions/generate/index.ts supabase/functions/image/index.ts supabase/functions/produce/index.ts supabase/functions/smartsend-webhook/index.ts supabase/functions/monitor/index.ts",
    "video:fonts": "node video/scripts/fonts.mjs",
    "typecheck:video": "tsc -p video/tsconfig.json",
    "sync:design": "node scripts/sync-design.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.536",
    "@remotion/cli": "^4.0.536",
    "@remotion/fonts": "^4.0.536",
    "@remotion/media-utils": "^4.0.535",
    "@remotion/renderer": "^4.0.536",
    "@remotion/transitions": "^4.0.536",
    "@remotion/vercel": "^4.0.536",
    "@vercel/functions": "^1.5.2",
    "@vercel/sandbox": "^1.10.2",
    "docx": "^9.12.0",
    "ffmpeg-static": "^5.3.0",
    "jszip": "^3.10.1",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.535"
  },
  "devDependencies": {
    "@fontsource/amatic-sc": "^5.3.0",
    "@fontsource/assistant": "^5.3.0",
    "@fontsource/bellefair": "^5.3.0",
    "@fontsource/heebo": "^5.3.0",
    "@fontsource/ibm-plex-sans-hebrew": "^5.3.0",
    "@fontsource/karantina": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/secular-one": "^5.3.0",
    "@fontsource/suez-one": "^5.3.0",
    "@fontsource/varela-round": "^5.3.0",
    "@sparticuz/chromium": "^149.0.0",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.31",
    "puppeteer-core": "^25.14.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.19"
  }
}
