{
  "name": "primeos",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-ui.mjs && vite",
    "build": "node scripts/build-ui.mjs && vite build",
    "preview": "vite preview",
    "typecheck:api": "tsc -p tsconfig.api.json --noEmit",
    "typecheck": "node --check public/primeos-live.js && node --check scripts/build-ui.mjs",
    "check:functions": "deno check --config supabase/functions/deno.ci.json --node-modules-dir=auto supabase/functions/v2-api/index.ts supabase/functions/generate/index.ts supabase/functions/image/index.ts supabase/functions/produce/index.ts"
  },
  "dependencies": {
    "@vercel/functions": "^1.5.2",
    "docx": "^9.7.1",
    "ffmpeg-static": "^5.2.0",
    "jszip": "^3.10.1",
    "pptxgenjs": "^3.12.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "@types/node": "^22.7.4",
    "puppeteer-core": "^25.9.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.19"
  }
}
