{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --include=dev",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/render.ts": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "{node_modules/ffmpeg-static/ffmpeg,api/_render/**}"
    },
    "api/video.ts": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "api/_video/**"
    }
  },
  "headers": [
    {
      "source": "/fn-src/(.*)\\.ts",
      "headers": [
        {
          "key": "content-type",
          "value": "application/typescript; charset=utf-8"
        },
        {
          "key": "cache-control",
          "value": "no-store"
        }
      ]
    }
  ]
}
