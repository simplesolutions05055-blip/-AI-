{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --include=dev",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/render.ts": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "{node_modules/ffmpeg-static/ffmpeg,api/_render/**}"
    },
    "api/video.ts": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "api/_video/**"
    },
    "api/convert.ts": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "node_modules/ffmpeg-static/ffmpeg"
    },
    "api/loadtest.ts": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "regions": [
    "fra1"
  ]
}
