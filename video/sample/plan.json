    { "dur": 2.6, "visual": { "kind": "video", "src": "sample/clip.mp4", "tint": 0.35 }, "text": { "style": "typewriter", "lines": ["יום חמישי, 20:00", "בפארק העירוני"] }, "transition": { "kind": "zoom" } },
    { "dur": 2.2, "visual": { "kind": "image", "src": "sample/p3.jpg", "motion": "zoomOut", "tint": 0.45 }, "text": { "style": "stamp", "lines": ["20.11"], "sub": "שומרים את התאריך" }, "transition": { "kind": "wipe", "dir": "right" } },
