    { "dur": 2.8, "visual": { "kind": "image", "src": "sample/p1.jpg", "motion": "panRight", "tint": 0.55, "blur": 6 }, "text": { "style": "quote", "lines": ["זה הערב שכל", "השכונה מחכה לו"], "sub": "תושבת העיר" }, "transition": { "kind": "clockWipe" } },
