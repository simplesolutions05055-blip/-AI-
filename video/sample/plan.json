    { "dur": 2.4, "visual": { "kind": "image", "src": "sample/p2.jpg", "motion": "zoomIn", "tint": 0.5 }, "text": { "style": "cinematic", "lines": ["ערב אחד", "של קסם"] }, "transition": { "kind": "push", "dir": "left" } },
